		<dc:title id="title">Of One Blood</dc:title>
		<meta property="file-as" refines="#title">Of One Blood</meta>
		<meta property="title-type" refines="#title">main</meta>
		<meta property="dcterms:alternative" refines="#title">Of 1 Blood</meta>
		<dc:title id="subtitle">Or, The Hidden Self</dc:title>
		<meta property="file-as" refines="#subtitle">Or, The Hidden Self</meta>
		<meta property="title-type" refines="#subtitle">subtitle</meta>
		<dc:title id="fulltitle">Of One Blood: Or, The Hidden Self</dc:title>
		<meta property="file-as" refines="#fulltitle">Of One Blood: Or, The Hidden Self</meta>
		<meta property="title-type" refines="#fulltitle">expanded</meta>
